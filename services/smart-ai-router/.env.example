# Environment Variables for Smart AI Router

# Required: Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: NVIDIA API Key (for speed optimization)
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=

# Optional: GCP Project ID (for Firestore cost tracking)
GCP_PROJECT_ID=

# Optional: Server port (default: 3002)
SMART_ROUTER_PORT=3002

# Optional: NVIDIA Base URL (default: https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
