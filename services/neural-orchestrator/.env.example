# ===================================================
# Neural Orchestrator - Environment Configuration
# ===================================================

# Google Cloud Platform
# ----------------------
# Your GCP project ID (find in GCP Console)
GCP_PROJECT=your-gcp-project-id

# GCP region for Cloud Functions deployment
GCP_REGION=us-central1

# Anthropic (Claude Models)
# --------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=REDACTED_OPENAI_API_KEY

# OpenAI (GPT Models)
# -------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=REDACTED_OPENAI_API_KEY

# Firebase Configuration (Optional - auto-detected from firebase.json)
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Rate Limiting Configuration
# --------------------------------------
# Maximum requests per minute per model (default: 60)
MAX_REQUESTS_PER_MINUTE=60

# Maximum concurrent batch requests (default: 5)
MAX_BATCH_CONCURRENCY=5

# Optional: Caching Configuration
# --------------------------------
# Cache TTL in milliseconds (default: 3600000 = 1 hour)
CACHE_TTL_MS=3600000

# Cache confidence threshold (default: 0.8)
CACHE_CONFIDENCE_THRESHOLD=0.8

# Optional: Cost Management
# -------------------------
# Maximum cost per request in USD (default: 0.10)
MAX_COST_PER_REQUEST=0.10

# Daily cost limit in USD (default: 100.00)
DAILY_COST_LIMIT=100.00

# Optional: Performance Tuning
# -----------------------------
# Number of retry attempts (default: 3)
MAX_RETRY_ATTEMPTS=3

# Exponential backoff base in seconds (default: 2)
BACKOFF_BASE_SECONDS=2

# Optional: Logging
# -----------------
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Enable detailed routing logs (default: false)
ENABLE_ROUTING_LOGS=false

# Enable cost tracking logs (default: true)
ENABLE_COST_LOGS=true

# ===================================================
# Setup Instructions
# ===================================================
#
# 1. Copy this file to .env
#    $ cp .env.example .env
#
# 2. Replace placeholder values with your actual credentials
#
# 3. For GCP_PROJECT:
#    - Go to GCP Console: https://console.cloud.google.com
#    - Copy your Project ID
#
# 4. For ANTHROPIC_API_KEY:
#    - Visit: https://console.anthropic.com/
#    - Navigate to API Keys section
#    - Generate new key
#
# 5. For OPENAI_API_KEY:
#    - Visit: https://platform.openai.com/api-keys
#    - Create new secret key
#
# 6. NEVER commit .env to version control
#    - Already in .gitignore
#
# 7. For production deployment:
#    - Store secrets in GCP Secret Manager:
#      $ gcloud secrets create anthropic-api-key --data-file=- <<< "sk-ant-xxx"
#      $ gcloud secrets create openai-api-key --data-file=- <<< "sk-xxx"
#
# ===================================================
