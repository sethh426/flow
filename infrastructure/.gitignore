# CLI configuration files
.terraformrc
terraform.rc

# Service account keys (ordinary infrastructure JSON remains trackable)
serviceAccountKey*.json
*serviceAccount*.json
credentials*.json

# Environment files
.env
.env.local
.env.*.local
