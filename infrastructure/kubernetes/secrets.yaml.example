# Kubernetes Secrets Configuration
# DO NOT commit this file to git if you fill in actual values!

apiVersion: v1
kind: Secret
metadata:
  name: gemini-api
  namespace: affiliate-flow
type: Opaque
stringData:
  api-key: "REDACTED_SECRET"
---
apiVersion: v1
kind: Secret
metadata:
  name: nordstrom-api
  namespace: affiliate-flow
type: Opaque
stringData:
  api-key: "REDACTED_SECRET"
---
apiVersion: v1
kind: Secret
metadata:
  name: firebase-admin
  namespace: affiliate-flow
type: Opaque
stringData:
  serviceAccountKey.json: |
    {
      "type": "service_account",
      "project_id": "flow-69826693-f6d27",
      "private_key_id": "YOUR_PRIVATE_KEY_ID",
      "private_key": "REDACTED_PRIVATE_KEY",
      "client_email": "firebase-adminsdk-fbsvc@flow-69826693-f6d27.iam.gserviceaccount.com",
      "client_id": "YOUR_CLIENT_ID",
      "auth_uri": "https://accounts.google.com/o/oauth2/auth",
      "token_uri": "https://oauth2.googleapis.com/token",
      "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
      "client_x509_cert_url": "YOUR_CERT_URL"
    }
