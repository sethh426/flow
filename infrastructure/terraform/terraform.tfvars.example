# Example terraform.tfvars
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git!

# GCP Project Configuration
project_id         = "affiliate-flow-prod"  # Your GCP project ID
region             = "us-central1"          # Your preferred region
environment        = "prod"

# Kubernetes Configuration
cluster_name       = "affiliate-flow-cluster"
min_nodes          = 2
max_nodes          = 10

# Notification Configuration
notification_email = "your-email@example.com"  # Email for alerts

# API Keys (SENSITIVE - Store securely!)
gemini_api_key     = "REDACTED_SECRET"
nordstrom_api_key  = ""  # Optional

# Domain Configuration (Optional)
domain_name        = ""  # e.g., "affiliateflow.com"

# Backup Configuration
enable_backup           = true
backup_retention_days   = 30
