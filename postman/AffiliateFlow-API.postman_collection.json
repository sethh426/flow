{
  "info": {
    "name": "AffiliateFlow API",
    "description": "Complete API collection for AffiliateFlow platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "affiliateflow"
  },
  "auth": {
    "type": "bearer",
