            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": \"content_123\",\n  \"products\": [\n    {\n      \"productId\": \"prod_1\",\n      \"position\": \"main\"\n    },\n    {\n      \"productId\": \"prod_2\",\n      \"position\": \"secondary\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{api_url}}/api/products/map",
              "host": ["{{api_url}}"],
              "path": ["api", "products", "map"]
            }
          },
          "response": []
