                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Create a social media post about fashion trends\",\n  \"platform\": \"instagram\",\n  \"tone\": \"casual\",\n  \"length\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/api/content/generate",
              "host": ["{{api_url}}"],
              "path": ["api", "content", "generate"]
            }
          },
          "response": []
