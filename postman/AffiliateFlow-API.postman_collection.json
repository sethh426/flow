    {
      "name": "Workflows",
      "item": [
        {
          "name": "List Workflows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/api/workflows",
              "host": ["{{api_url}}"],
              "path": ["api", "workflows"]
            }
          },
          "response": []
        },
        {
          "name": "Create Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fashion Content Pipeline\",\n  \"description\": \"Automated content generation for fashion products\",\n  \"nodes\": [\n    {\n      \"id\": \"trend-finder\",\n      \"type\": \"trend-finder\",\n      \"config\": {}\n    },\n    {\n      \"id\": \"content-gen\",\n      \"type\": \"content-generator\",\n      \"config\": {}\n    },\n    {\n      \"id\": \"product-map\",\n      \"type\": \"product-mapper\",\n      \"config\": {}\n    }\n  ],\n  \"edges\": [\n    {\n      \"source\": \"trend-finder\",\n      \"target\": \"content-gen\"\n    },\n    {\n      \"source\": \"content-gen\",\n      \"target\": \"product-map\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{api_url}}/api/workflows",
              "host": ["{{api_url}}"],
              "path": ["api", "workflows"]
            }
          },
          "response": []
        },
        {
          "name": "Get Workflow",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/api/workflows/:workflowId",
              "host": ["{{api_url}}"],
              "path": ["api", "workflows", ":workflowId"],
              "variable": [
                {
                  "key": "workflowId",
                  "value": "workflow_123"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Execute Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"category\": \"fashion\",\n    \"keywords\": [\"summer\", \"casual\"]\n  }\n}"
            },
            "url": {
              "raw": "{{api_url}}/api/workflows/:workflowId/execute",
              "host": ["{{api_url}}"],
              "path": ["api", "workflows", ":workflowId", "execute"],
              "variable": [
                {
                  "key": "workflowId",
                  "value": "workflow_123"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Workflow",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{api_url}}/api/workflows/:workflowId",
              "host": ["{{api_url}}"],
              "path": ["api", "workflows", ":workflowId"],
              "variable": [
                {
                  "key": "workflowId",
                  "value": "workflow_123"
                }
              ]
            }
          },
          "response": []
