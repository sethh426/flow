          "name": "Search Products",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"summer dresses\",\n  \"retailer\": \"nordstrom\",\n  \"maxResults\": 10\n}"
            },
            "url": {
              "raw": "{{api_url}}/api/products/search",
              "host": ["{{api_url}}"],
              "path": ["api", "products", "search"]
            }
          },
          "response": []
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/api/products/:productId",
              "host": ["{{api_url}}"],
              "path": ["api", "products", ":productId"],
              "variable": [
                {
                  "key": "productId",
                  "value": "12345"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Map Content to Products",
          "request": {
            "method": "POST",
