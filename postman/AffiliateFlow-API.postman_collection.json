          "name": "Generate Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Modern fashion influencer in urban setting\",\n  \"style\": \"photorealistic\",\n  \"size\": \"1024x1024\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/api/image/generate",
