'use client';

import { 
  Container, 
  Typography, 
  Box, 
  Paper, 
  AppBar, 
  Toolbar, 
  Grid, 
  Card, 
  CardContent,
  Chip,
  Button,
  Tabs,
  Tab,
  IconButton,
  Menu,
  MenuItem,
} from '@mui/material';
import { useState, useEffect } from 'react';
import TrendingUpIcon from '@mui/icons-material/TrendingUp';
import AutoAwesomeIcon from '@mui/icons-material/AutoAwesome';
import InsightsIcon from '@mui/icons-material/Insights';
import ImageIcon from '@mui/icons-material/Image';
import SmartToyIcon from '@mui/icons-material/SmartToy';
import CampaignIcon from '@mui/icons-material/Campaign';
import DashboardIcon from '@mui/icons-material/Dashboard';
import AccountCircleIcon from '@mui/icons-material/AccountCircle';
import BrushIcon from '@mui/icons-material/Brush';
import CampaignManager from '@/components/CampaignManager';
import AuthDialog from '@/components/AuthDialog';
import ContentStudio from '@/components/ContentStudio';
import TrendFinder from '@/components/TrendFinder';
import Analytics from '@/components/Analytics';
import { onAuthChange, logOut } from '@/lib/auth';

export default function DashboardPage() {
  const [currentTab, setCurrentTab] = useState(0);
  const [authDialogOpen, setAuthDialogOpen] = useState(false);
  const [user, setUser] = useState<any>(null);
  const [anchorEl, setAnchorEl] = useState<null | HTMLElement>(null);

  useEffect(() => {
    const unsubscribe = onAuthChange((currentUser) => {
      setUser(currentUser);
      console.log('Auth state changed:', currentUser?.email || 'Not signed in');
    });
    return () => unsubscribe();
  }, []);

  const handleSignOut = async () => {
    await logOut();
    setAnchorEl(null);
  };

  const handleFeatureClick = (action: string) => {
    switch (action) {
      case 'Find Trends':
        setCurrentTab(3); // Navigate to Trend Finder tab
        break;
      case 'Generate Content':
        setCurrentTab(2); // Navigate to Content Studio tab
        break;
      case 'View Analytics':
        setCurrentTab(4); // Navigate to Analytics tab
        break;
      case 'Click Flow avatar to chat':
        // FlowBot is always visible in bottom right
        break;
      case 'Deploy to Cloud Run':
        window.open('https://image-generator-292572827197.us-central1.run.app/health', '_blank');
        break;
    }
  };

  const features = [
    {
      title: 'Flow Autopilot',
      description: 'AI agent that autonomously controls your marketing workflow',
      icon: <SmartToyIcon sx={{ fontSize: 40, color: '#667eea' }} />,
      status: 'Live',
      action: 'Click Flow avatar to chat',
    },
    {
      title: 'AI Image Generation',
      description: 'Create product visuals with Gemini 2.5 Flash',
      icon: <ImageIcon sx={{ fontSize: 40, color: '#764ba2' }} />,
      status: 'Ready',
      action: 'Deploy to Cloud Run',
    },
    {
      title: 'Trend Finder',
      description: 'Discover trending products and topics',
      icon: <TrendingUpIcon sx={{ fontSize: 40, color: '#f093fb' }} />,
      status: 'Available',
      action: 'Find Trends',
    },
    {
      title: 'Content Generator',
      description: 'Auto-generate marketing content and posts',
      icon: <AutoAwesomeIcon sx={{ fontSize: 40, color: '#4facfe' }} />,
      status: 'Available',
      action: 'Generate Content',
    },
    {
      title: 'Analytics',
      description: 'Track performance and insights',
      icon: <InsightsIcon sx={{ fontSize: 40, color: '#43e97b' }} />,
      status: 'Coming Soon',
      action: 'View Analytics',
    },
  ];

  return (
    <Box sx={{ bgcolor: '#f5f7fa', minHeight: '100vh' }}>
      {/* Welcome Section */}
      <Box sx={{ mb: 4 }}>
        <Typography variant="h3" component="h1" gutterBottom fontWeight={700}>
          Welcome Back! �
        </Typography>
        <Typography variant="h6" color="text.secondary">
          Your AI-powered affiliate marketing command center
        </Typography>
      </Box>
          </Typography>
          <Chip 
            label="Production" 
            size="small" 
            sx={{ 
              bgcolor: 'rgba(255,255,255,0.2)', 
              color: 'white',
              fontWeight: 600,
              mr: 2
            }} 
          />
          {user ? (
            <>
              <IconButton
                onClick={(e) => setAnchorEl(e.currentTarget)}
                sx={{ color: 'white' }}
              >
                <AccountCircleIcon />
              </IconButton>
              <Menu
                anchorEl={anchorEl}
                open={Boolean(anchorEl)}
                onClose={() => setAnchorEl(null)}
              >
                <MenuItem disabled>
                  <Typography variant="body2">{user.email}</Typography>
                </MenuItem>
                <MenuItem onClick={handleSignOut}>Sign Out</MenuItem>
              </Menu>
            </>
          ) : (
            <Button
              variant="outlined"
              size="small"
              onClick={() => setAuthDialogOpen(true)}
              sx={{ 
                color: 'white', 
                borderColor: 'white',
                '&:hover': {
                  borderColor: 'white',
                  bgcolor: 'rgba(255,255,255,0.1)'
                }
              }}
            >
              Sign In
            </Button>
          )}
        </Toolbar>
      </AppBar>
      
      <Container component="main" sx={{ mt: 4, mb: 2, flex: '1 0 auto' }}>
        {/* Tab Navigation */}
        <Box sx={{ borderBottom: 1, borderColor: 'divider', mb: 3 }}>
          <Tabs value={currentTab} onChange={(e, newValue) => setCurrentTab(newValue)}>
            <Tab icon={<DashboardIcon />} label="Overview" iconPosition="start" />
            <Tab icon={<CampaignIcon />} label="Campaigns" iconPosition="start" />
            <Tab icon={<BrushIcon />} label="Content Studio" iconPosition="start" />
            <Tab icon={<TrendingUpIcon />} label="Trend Finder" iconPosition="start" />
            <Tab icon={<InsightsIcon />} label="Analytics" iconPosition="start" />
          </Tabs>
        </Box>

        {/* Tab Content */}
        {currentTab === 0 && (
          <>
            <Box sx={{ mb: 4 }}>
              <Typography variant="h3" component="h1" gutterBottom fontWeight={700}>
                Welcome Back! 👋
              </Typography>
              <Typography variant="h6" color="text.secondary">
                Your AI-powered affiliate marketing command center
              </Typography>
            </Box>

            {/* Quick Stats */}
            <Grid container spacing={3} sx={{ mb: 4 }}>
              <Grid item xs={12} md={4}>
                <Paper sx={{ p: 3, background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: 'white' }}>
                  <Typography variant="h6" gutterBottom>Flow Orchestrator</Typography>
                  <Typography variant="h4" fontWeight={700}>Live ✨</Typography>
                  <Typography variant="body2" sx={{ mt: 1, opacity: 0.9 }}>
                    Backend running on Cloud Run
                  </Typography>
                </Paper>
              </Grid>
          <Grid item xs={12} md={4}>
            <Paper sx={{ p: 3, background: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)', color: 'white' }}>
              <Typography variant="h6" gutterBottom>AI Flows</Typography>
              <Typography variant="h4" fontWeight={700}>15</Typography>
              <Typography variant="body2" sx={{ mt: 1, opacity: 0.9 }}>
                Genkit AI flows ready
              </Typography>
            </Paper>
          </Grid>
          <Grid item xs={12} md={4}>
            <Paper sx={{ p: 3, background: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)', color: 'white' }}>
              <Typography variant="h6" gutterBottom>Services</Typography>
              <Typography variant="h4" fontWeight={700}>3/4</Typography>
              <Typography variant="body2" sx={{ mt: 1, opacity: 0.9 }}>
                Deployed & running
              </Typography>
            </Paper>
          </Grid>
        </Grid>

        {/* Features Grid */}
        <Typography variant="h5" gutterBottom fontWeight={600} sx={{ mb: 3 }}>
          Available Features
        </Typography>
        <Grid container spacing={3}>
          {features.map((feature, index) => (
            <Grid item xs={12} md={6} key={index}>
              <Card 
                sx={{ 
                  height: '100%',
                  transition: 'transform 0.2s, box-shadow 0.2s',
                  '&:hover': {
                    transform: 'translateY(-4px)',
                    boxShadow: 6,
                  },
                }}
              >
                <CardContent sx={{ p: 3 }}>
                  <Box sx={{ display: 'flex', alignItems: 'start', mb: 2 }}>
                    <Box sx={{ mr: 2 }}>{feature.icon}</Box>
                    <Box sx={{ flex: 1 }}>
                      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
                        <Typography variant="h6" fontWeight={600}>
                          {feature.title}
                        </Typography>
                        <Chip 
                          label={feature.status} 
                          size="small"
                          color={feature.status === 'Live' ? 'success' : feature.status === 'Ready' ? 'primary' : 'default'}
                        />
                      </Box>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        {feature.description}
                      </Typography>
                      <Button 
                        variant="outlined" 
                        size="small"
                        disabled={feature.status === 'Coming Soon'}
                        onClick={() => handleFeatureClick(feature.action)}
                      >
                        {feature.action}
                      </Button>
                    </Box>
                  </Box>
                </CardContent>
              </Card>
            </Grid>
          ))}
        </Grid>

        {/* Getting Started */}
        <Paper sx={{ p: 4, mt: 4, background: 'linear-gradient(135deg, #667eea15 0%, #764ba215 100%)' }}>
          <Typography variant="h5" gutterBottom fontWeight={600}>
            🎯 Quick Start
          </Typography>
          <Box component="ul" sx={{ pl: 2, '& li': { mb: 1 } }}>
            <li>
              <Typography variant="body1">
                <strong>Chat with Flow:</strong> Click the purple avatar in the bottom-right corner to start a conversation
              </Typography>
            </li>
            <li>
              <Typography variant="body1">
                <strong>Generate Images:</strong> Use the Image Generator API to create product visuals
              </Typography>
            </li>
            <li>
              <Typography variant="body1">
                <strong>Find Trends:</strong> Explore trending products and topics in your niche
              </Typography>
            </li>
            <li>
              <Typography variant="body1">
                <strong>Autopilot Mode:</strong> Let Flow autonomously manage your marketing workflows
              </Typography>
            </li>
          </Box>
        </Paper>
      </>
      )}
      {/* Campaigns Tab */}
      {currentTab === 1 && (
        <CampaignManager />
      )}

      {/* Content Studio Tab */}
      {currentTab === 2 && (
        <ContentStudio />
      )}

      {/* Trend Finder Tab */}
      {currentTab === 3 && (
        <TrendFinder />
      )}

      {/* Analytics Tab */}
      {currentTab === 4 && (
        <Analytics />
      )}
    </Container>
      
      <Box component="footer" sx={{ py: 3, px: 2, mt: 'auto', backgroundColor: (theme) => theme.palette.grey[200] }}>
        <Container maxWidth="lg">
          <Typography variant="body2" color="text.secondary" align="center">
            © 2025 Affiliate Flow • Powered by Gemini AI • Running on Google Cloud
          </Typography>
        </Container>
      </Box>

      {/* Auth Dialog */}
      <AuthDialog
        open={authDialogOpen}
        onClose={() => setAuthDialogOpen(false)}
        onSuccess={() => {
          console.log('Auth successful!');
        }}
      />
    </Box>
  );
}
